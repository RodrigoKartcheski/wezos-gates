{
    "source": {
        "type": "csv",
        "file": "samples/ecommerce_orders_v1.csv",
        "chunk_size": 10,
        "parallel_workers": 2
    },
    "validations": {
        "primary_key": {
            "columns": ["order_id"],
            "mandatory": true
        },
        "null_checks": [
            { "column": "order_id" },
            { "column": "customer_id" },
            { "column": "email", "max_percent": 5 }
        ],
        "domain_checks": [
            { "column": "status", "allowed_values": ["DELIVERED", "SHIPPED", "CANCELLED", "RETURNED", "PENDING"] }
        ],
        "numeric_checks": [
            { "column": "quantity", "min": 1 },
            { "column": "unit_price", "min": 0.01 }
        ],
        "comparison_checks": [
            { "equation": "quantity * unit_price == total_price" }
        ],
        "schema": {
            "order_id": "int64",
            "quantity": "int64",
            "unit_price": "float64",
            "status": "object"
        }
    },
    "discovery": {
        "detect_keys": true,
        "group_by": ["status"],
        "date_analysis": ["order_date"]
    },
    "profiling": {
        "title": "E-commerce Orders V1 Profiling"
    },
    "save_history": true
}

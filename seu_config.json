{
  "file": "sample_data.csv",
  "validations": {
    "primary_key": [
      "id"
    ],
    "null_checks": [
      {
        "column": "email",
        "max_percent": 0
      }
    ]
  },
  "discovery": {
    "filter": "idade > 30",
    "group_by": [
      "status",
      "idade"
    ],
    "dedupIncludeColumns": [
      "nome",
      "valor"
    ],
    "dedupExcludeColumns": [
      "id",
      "status",
      "email",
      "idade",
      "data_cadastro"
    ]
  }
}